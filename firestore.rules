rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'big99webdeveloper@gmail.com' ||
        request.auth.token.email == 'kedar121289@gmail.com' ||
        (request.auth.token.email is string && request.auth.token.email.lower() == 'big99webdeveloper@gmail.com') ||
        (request.auth.token.email is string && request.auth.token.email.lower() == 'kedar121289@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Health check connection test document
    match /test/{docId} {
      allow get: if true;
    }

    // Public catalog items
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /freebies/{freebieId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // General store configuration - Public readable for website display, strictly Admin writeable
    match /settings/{settingDoc} {
      allow get: if isValidId(settingDoc);
      allow list: if false;
      allow create, update: if isAdmin() && isValidId(settingDoc);
      allow delete: if false;
    }

    // Orders and enquiries
    match /orders/{orderId} {
      allow create: if isValidId(orderId) &&
        request.resource.data.orderNumber is string &&
        request.resource.data.customerName is string &&
        request.resource.data.customerPhone is string;
      allow get: if isAdmin() || (isSignedIn() && resource.data.customerEmail == request.auth.token.email);
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Bulk enquiries
    match /bulkEnquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) &&
        request.resource.data.companyName is string &&
        request.resource.data.contactPerson is string &&
        request.resource.data.phone is string;
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Analytics and outbound marketplace redirection logging
    match /analyticsEvents/{eventId} {
      allow create: if isValidId(eventId) && request.resource.data.eventType is string;
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Blog articles - Publicly readable, verified authenticated users or admins can create, admins can update/delete
    function isValidBlogPost(data) {
      return data.keys().hasAll(['id', 'slug', 'title', 'excerpt', 'content', 'date', 'category']) &&
        data.keys().hasOnly(['id', 'slug', 'title', 'excerpt', 'content', 'author', 'date', 'readTime', 'category', 'tags', 'image', 'imagePosition', 'published', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 200 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 220 &&
        data.excerpt is string && data.excerpt.size() <= 600 &&
        data.content is string && data.content.size() > 0 && data.content.size() <= 25000 &&
        data.date is string && data.date.size() <= 64 &&
        data.category is string && data.category.size() <= 80 &&
        (!('author' in data) || (data.author is string && data.author.size() <= 120)) &&
        (!('readTime' in data) || (data.readTime is string && data.readTime.size() <= 40)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
        (!('image' in data) || data.image == null || (data.image is string && data.image.size() <= 800000)) &&
        (!('imagePosition' in data) || data.imagePosition in ['top', 'bottom']) &&
        (!('published' in data) || data.published is bool);
    }

    match /blogs/{blogId} {
      allow get, list: if true;
      allow create: if (isAdmin() || (isSignedIn() && request.auth.token.email_verified == true)) &&
        isValidId(blogId) &&
        isValidBlogPost(request.resource.data);
      allow update: if isAdmin() && isValidId(blogId) && isValidBlogPost(request.resource.data);
      allow delete: if isAdmin() && isValidId(blogId);
    }

    // Administrator registry
    match /admins/{adminUid} {
      allow read, write: if isAdmin();
    }
  }
}
